# ===========================================================
# Copy these into Railway → your service → Variables.
# (Locally: copy to .env — which is gitignored — and fill in.)
# ===========================================================

# --- Required: Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Required: Google Sheet payment gate ---
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@your-project.iam.gserviceaccount.com
# Paste the full key. Keep the literal \n sequences (code converts them to real newlines).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIxxxx...\n-----END PRIVATE KEY-----\n"

# --- Required for cron correctness: timezone for the nightly memory job ---
TZ=Asia/Kolkata

# --- Optional ---
# PORT is injected by Railway automatically — do NOT set it manually there.
# GROQ_API_KEY enables voice-note transcription (omit to disable).
GROQ_API_KEY=
# Landing/payment URL shown to unpaid users.
LANDING_PAGE_URL=https://yoursite.com
# Override the nightly memory cron (default: 30 3 * * * = 3:30 AM).
MEMORY_CRON=30 3 * * *
# Human-like reply delay window (ms).
MIN_REPLY_DELAY_MS=2000
MAX_REPLY_DELAY_MS=5000

# --- Storage paths (defaults already match the Railway volume mounts) ---
# AUTH_DIR=/app/auth
# DATA_DIR=/app/data
