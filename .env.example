# ===========================================================
# Copy these into Railway → your service → Variables.
# (Locally: copy to .env — which is gitignored — and fill in.)
# ===========================================================

# --- Required: Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Required: Google Sheet payment gate ---
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@your-project.iam.gserviceaccount.com
# Paste the full key. Keep the literal \n sequences (code converts them to real newlines).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIxxxx...\n-----END PRIVATE KEY-----\n"

# --- Required for cron correctness: timezone for the nightly memory job ---
TZ=Asia/Kolkata

# --- Optional ---
# PORT is injected by Railway automatically — do NOT set it manually there.
# GROQ_API_KEY enables voice-note transcription (omit to disable).
GROQ_API_KEY=
# Landing/payment URL shown to unpaid users.
LANDING_PAGE_URL=https://yoursite.com
# Override the nightly memory cron (default: 30 3 * * * = 3:30 AM).
MEMORY_CRON=30 3 * * *
# Human-like reply delay window (ms).
MIN_REPLY_DELAY_MS=2000
MAX_REPLY_DELAY_MS=5000

# Optional: lock the /qr pairing page behind a token. If unset, /qr is open
# (one-click pairing). If set, open https://<domain>/qr?t=<this-value>.
# QR_ACCESS_TOKEN=

# Optional: log in with a PAIRING CODE instead of scanning a QR (more reliable
# on a server). Set the bot's full WhatsApp number, digits only incl. country
# code. On first pair, an 8-char code prints in the deploy logs — enter it in
# WhatsApp → Linked Devices → "Link with phone number instead".
# PAIRING_NUMBER=917303965115

# --- Storage paths (defaults already match the Railway volume mounts) ---
# AUTH_DIR=/app/auth
# DATA_DIR=/app/data

# ── TheBroThing dashboard approval (optional) ──────────────────────────────
# Lets an admin approve a user from the website backend so they chat free.
# Public anon key only (no secrets). Run leads-approval.sql in that Supabase.
SUPABASE_URL=https://fshzhvxqlkblsgiealzv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# ── Auto-approve on payment (Razorpay) ────────────────────────────────────
# When a user hits the free limit, the bot creates a Razorpay payment link
# tagged with their WhatsApp number. Paying unlocks them for PAID_DAYS days.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
FLIRT_PRICE_PAISE=99900          # ₹999 (amount is in paise)
PAID_DAYS=30                     # access length after payment
# Service key ONLY used by the payment webhook to write paid_until (server-side).
SUPABASE_SERVICE_KEY=sb_secret_ROTATE_ME
